PORT=3000
TMDB_API_KEY=isi_api_key_tmdb_kamu

# Opsional: ganti jika memakai proxy/base URL TMDB lain.
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMG_URL=https://image.tmdb.org/t/p/w500

# Pilih salah satu untuk source video legal milikmu.
VIDEO_SOURCE_MANIFEST_PATH=video-sources.json
# VIDEO_SOURCE_MANIFEST={"movies":{"550":{"sources":[{"label":"CDN HLS","url":"https://cdn.example.com/movies/550/master.m3u8","type":"hls"}]}}}
# VIDEO_SOURCE_API_URL=https://api.example.com/sources
